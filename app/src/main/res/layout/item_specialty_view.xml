<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/gray_e0"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Specialty Icon -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_specialty_placeholder"
                android:background="@drawable/bg_specialty_icon"
                android:padding="12dp"
                app:tint="@color/blue_007b" />

            <!-- Specialty Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSpecialtyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khoa Tim mạch"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSpecialtyDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Chuyên điều trị các bệnh về tim và mạch máu"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Selection Indicator -->
            <ImageView
                android:id="@+id/iconSelected"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/blue_007b"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Đặt lịch ngay Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookNow"
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/blue_447f"
            android:text="Đặt lịch ngay"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:cornerRadius="18dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
